{
  "name": "pi-clean-mode",
  "version": "0.2.0",
  "description": "Collapse a whole agent run into a single duration header, leaving only the final answer",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "locales",
    "config.example.json",
    "README.md",
    "README.zh-CN.md",
    "SKILL.md",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test && npm pack --dry-run --json > /dev/null"
  },
  "pi": {
    "extensions": [
      "./index.ts",
      "../pi-extensions-i18n/index.ts"
    ],
    "skills": [
      "./SKILL.md"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "maplezzk",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-clean-mode",
  "bugs": {
    "url": "https://github.com/maplezzk/pi-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-clean-mode"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "clean-mode",
    "transcript"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "dependencies": {
    "pi-extensions-i18n": "^0.7.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
