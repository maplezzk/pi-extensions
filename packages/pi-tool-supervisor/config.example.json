{
  "enabled": true,
  "timeoutSeconds": 10,
  "maxFileContextChars": 50000,
  "maxRuleLines": 100,
  "typesafe": {
    "apiKey": "<your-typesafe-api-key>",
    "endpoint": "https://api.typesafe.ai/v1/systemone"
  },
  "reviewers": [
    {
      "name": "java-safety-local",
      "model": "provider/model",
      "rulesFiles": [
        "/absolute/path/to/rules.md"
      ],
      "tools": [
        "edit",
        "write"
      ],
      "trigger": "after",
      "condition": "/absolute/path/to/condition.ts"
    },
    {
      "name": "code-taste",
      "backend": "typesafe",
      "typesafeModel": "jev-latest",
      "rulesFiles": [
        "/absolute/path/to/javascript-typescript.md"
      ],
      "tools": [
        "edit",
        "write"
      ],
      "trigger": "after"
    },
    {
      "name": "cloudflare-quality",
      "backend": "cloudflare",
      "cloudflareModel": "clef-flash",
      "rulesFiles": [
        "./rules/code-quality.md"
      ],
      "tools": [
        "edit",
        "write"
      ],
      "trigger": "after"
    },
    {
      "name": "decisions-quality",
      "backend": "openai-decisions",
      "openaiDecisionsModel": "gpt-6-luna",
      "rulesFiles": [
        "./rules/code-quality.md"
      ],
      "tools": [
        "edit",
        "write"
      ],
      "trigger": "after"
    }
  ],
  "cloudflare": {
    "baseUrl": "https://api.cloudflare.com/client/v4",
    "accountIdEnv": "CLOUDFLARE_ACCOUNT_ID",
    "tokenEnv": "CLOUDFLARE_API_TOKEN"
  },
  "openaiDecisions": {
    "baseUrl": "https://api.openai.com/v1",
    "apiKeyEnv": "OPENAI_API_KEY"
  }
}
